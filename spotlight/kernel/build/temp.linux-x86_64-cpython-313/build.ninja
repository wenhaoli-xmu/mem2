ninja_required_version = 1.3
cxx = c++
nvcc = /mnt/rl-train/wenhaoli/miniconda3/envs/spot-agent/bin/nvcc

cflags = -pthread -B /mnt/rl-train/wenhaoli/miniconda3/compiler_compat -fno-strict-overflow -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /mnt/rl-train/wenhaoli/miniconda3/include -fPIC -O2 -isystem /mnt/rl-train/wenhaoli/miniconda3/include -fPIC -I/mnt/rl-train/wenhaoli/miniconda3/lib/python3.13/site-packages/torch/include -I/mnt/rl-train/wenhaoli/miniconda3/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -I/mnt/rl-train/wenhaoli/miniconda3/lib/python3.13/site-packages/torch/include/TH -I/mnt/rl-train/wenhaoli/miniconda3/lib/python3.13/site-packages/torch/include/THC -I/mnt/rl-train/wenhaoli/miniconda3/envs/spot-agent/include -I/mnt/rl-train/wenhaoli/miniconda3/include/python3.13 -c
post_cflags = -O3 -std=c++17 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=hash_packbits -D_GLIBCXX_USE_CXX11_ABI=0
cuda_cflags = -I/mnt/rl-train/wenhaoli/miniconda3/lib/python3.13/site-packages/torch/include -I/mnt/rl-train/wenhaoli/miniconda3/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -I/mnt/rl-train/wenhaoli/miniconda3/lib/python3.13/site-packages/torch/include/TH -I/mnt/rl-train/wenhaoli/miniconda3/lib/python3.13/site-packages/torch/include/THC -I/mnt/rl-train/wenhaoli/miniconda3/envs/spot-agent/include -I/mnt/rl-train/wenhaoli/miniconda3/include/python3.13 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -std=c++17 -arch=sm_90 --use_fast_math --expt-relaxed-constexpr --threads=4 -Xptxas -v -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=hash_packbits -D_GLIBCXX_USE_CXX11_ABI=0
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /mnt/rl-train/wenhaoli/gdrive/project/spotlight/spotlight/kernel/build/temp.linux-x86_64-cpython-313/hash_packbits.o: cuda_compile /mnt/rl-train/wenhaoli/gdrive/project/spotlight/spotlight/kernel/hash_packbits.cu






